# Export these values in your shell (the application does not implicitly load .env).
PATHSNAP_TRIP_DIR=./evaluator_test/evaluator_test
PATHSNAP_FEATURE_DIR=./data/authoritative
PATHSNAP_MODEL_MANIFEST=./models/model_manifest.json
# Replace with the exact frontend origin of Laptop 2, including scheme and port.
PATHSNAP_CORS_ORIGINS=http://192.168.1.21:5173
PATHSNAP_MAX_WORKERS=1
PATHSNAP_MAX_JOBS=16
PATHSNAP_JOB_RETENTION_SECONDS=3600
PATHSNAP_JOB_TIMEOUT_SECONDS=120
